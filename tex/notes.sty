% ---------- the machine, drawn block by block ----------
% \machine{N}{caption}: the whole decoder, with blocks from chapters < N drawn solid, blocks from
% chapter N highlighted, and blocks still ahead drawn as dashed ghosts.
\newcount\machinech
\tikzset{
  mdone/.style={draw=black, line width=0.8pt, fill=black!7, text=black},
  mcur/.style={draw=black, line width=2pt, fill=black!25, text=black},
  mghost/.style={draw=black!45, dashed, line width=0.6pt, fill=white, text=black!55},
  st/.code={\ifnum#1<\machinech\tikzset{mdone}\else\ifnum#1=\machinech\tikzset{mcur}\else\tikzset{mghost}\fi\fi},
  sttwo/.code 2 args={\ifnum#2=\machinech\tikzset{mcur}\else\ifnum#1=\machinech\tikzset{mcur}\else
     \ifnum#1<\machinech\tikzset{mdone}\else\tikzset{mghost}\fi\fi\fi},
  stthree/.code n args={3}{\ifnum#1=\machinech\tikzset{mcur}\else\ifnum#2=\machinech\tikzset{mcur}\else
     \ifnum#3=\machinech\tikzset{mcur}\else\ifnum#1<\machinech\tikzset{mdone}\else\tikzset{mghost}\fi\fi\fi\fi},
  mbox/.style={rounded corners=3pt, minimum width=6.9cm, minimum height=0.74cm, align=center, font=\small, inner sep=2pt},
  sbox/.style={rounded corners=3pt, text width=2.7cm, minimum height=1.1cm, align=center, font=\footnotesize, inner sep=3pt},
  marr/.style={-{Stealth[length=2.6mm]}, line width=0.8pt, black!80},
  mtag/.style={font=\footnotesize\itshape, text=black!75, anchor=east},
  mshape/.style={font=\footnotesize, text=black!80, anchor=west},
}
\newcommand{\machinediagram}[1]{%
\machinech=#1\relax
\begin{tikzpicture}[x=1cm,y=1cm]
% main column
\node[mbox, st=1] (txt) at (0,0) {text in: \texttt{waste of time}};
\node[mbox, st=2] (tok) at (0,-1.1) {cut into tokens, look up their ids};
\node[mbox, st=2] (emb) at (0,-2.2) {embedding: one arrow per token};
\node[mbox, sttwo={6}{10}] (n1) at (0,-3.55) {\ifnum\machinech<10 norm\else RMSNorm\fi};
\node[mbox, stthree={3}{5}{10}, minimum height=1.0cm] (att) at (0,-4.75) {%
  \ifnum\machinech<5 attention: tokens talk\else\ifnum\machinech<10 multi-head attention: tokens talk\else grouped-query attention\\[-1pt]with QK-norm\fi\fi};
\node[circle, draw, st=5, inner sep=1pt, minimum size=0.62cm, font=\normalsize] (a1) at (0,-5.95) {$+$};
\node[mbox, sttwo={6}{10}] (n2) at (0,-7.0) {\ifnum\machinech<10 norm\else RMSNorm\fi};
\node[mbox, sttwo={5}{10}] (mlp) at (0,-8.1) {\ifnum\machinech<10 MLP: each token thinks alone\else SwiGLU MLP: each token thinks alone\fi};
\node[circle, draw, st=5, inner sep=1pt, minimum size=0.62cm, font=\normalsize] (a2) at (0,-9.2) {$+$};
\node[mbox, st=6] (fn) at (0,-10.45) {final norm};
\node[mbox, st=7] (un) at (0,-11.55) {scores for every word in the vocabulary};
\node[mbox, st=7] (sm) at (0,-12.65) {softmax, then pick the next word};
% the repeated layer frame
\draw[rounded corners=6pt, st=5, fill=none] (-3.75,-2.95) rectangle (4.25,-9.85);
\node[anchor=south west, font=\footnotesize, st=5, draw=none, fill=none] at (-3.7,-9.8) {repeated $L$ times};
% side boxes
\node[sbox, st=4] (pos) at (-6.9,-4.75) {positions:\\RoPE turns $q$ and $k$};
\node[sbox, st=9] (kv) at (6.3,-4.75) {KV cache: keep old keys and values};
\node[sbox, st=8] (loss) at (6.3,-12.65) {loss: surprise at the right word (training)};
% arrows along the column
\foreach \a/\b in {txt/tok, tok/emb, emb/n1, n1/att, att/a1, a1/n2, n2/mlp, mlp/a2, a2/fn, fn/un, un/sm} \draw[marr] (\a) -- (\b);
\draw[marr] (pos) -- (att); \draw[marr, <->] (att) -- (kv); \draw[marr] (sm) -- (loss);
% residual paths
\draw[marr] (0,-2.95) -- (3.85,-2.95) |- (a1);
\draw[marr] (0,-6.45) -- (3.85,-6.45) |- (a2);
% shapes
\node[mshape] at (0.12,-1.65) {$B\times T$};
\node[mshape] at (0.12,-2.62) {$B\times T\times d$};
\node[mshape] at (0.12,-12.1) {$B\times T\times V$};
% chapter tags
\foreach \n/\c in {txt/1, tok/2, emb/2, n1/6, att/{3, 5}, n2/6, mlp/5, fn/6, un/7, sm/7}
  \node[mtag, anchor=north east] at ([xshift=-4.5mm]\n.north west) {Ch.\ \c};
\end{tikzpicture}}
\newcommand{\machinelegend}{%
\tikz[baseline=-0.6ex]\node[mdone, rounded corners=2pt, minimum width=0.7cm, minimum height=0.32cm]{};\ built earlier\quad
\tikz[baseline=-0.6ex]\node[mcur, rounded corners=2pt, minimum width=0.7cm, minimum height=0.32cm]{};\ built in this chapter\quad
\tikz[baseline=-0.6ex]\node[mghost, rounded corners=2pt, minimum width=0.7cm, minimum height=0.32cm]{};\ still ahead}
\newcommand{\machine}[2]{%
\begin{figure}[!htb]\centering
\resizebox{\linewidth}{!}{\machinediagram{#1}}\\[4pt]
{\small\machinelegend}
\caption{\textbf{Where we are in the machine.} #2}
\end{figure}}
